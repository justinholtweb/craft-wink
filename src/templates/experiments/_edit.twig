{% extends '_layouts/cp.twig' %}
{% import '_includes/forms.twig' as forms %}

{% set selectedSubnavItem = 'experiments' %}
{% set fullPageForm = true %}
{% set saveShortcutRedirect = experiment.cpEditUrl ?? cpUrl('wink/experiments/{id}') %}

{% block header %}
    {{ parent() }}
{% endblock %}

{% block content %}
    {{ actionInput('wink/experiments/save') }}
    {{ redirectInput('wink/experiments/{id}') }}

    {% if experiment.id %}
        {{ hiddenInput('experimentId', experiment.id) }}
    {% endif %}

    <div id="fields">
        {# Details #}
        <div id="tab-details">
            {{ forms.textField({
                first: true,
                label: 'Title'|t('app'),
                id: 'title',
                name: 'title',
                value: experiment.title,
                errors: experiment.getErrors('title'),
                autofocus: true,
                required: true,
            }) }}

            {{ forms.textField({
                label: 'Handle'|t('wink'),
                id: 'handle',
                name: 'handle',
                value: experiment.handle,
                errors: experiment.getErrors('handle'),
                required: true,
                instructions: 'Used in Twig tags to reference this experiment.'|t('wink'),
            }) }}

            {{ forms.textareaField({
                label: 'Description'|t('app'),
                id: 'description',
                name: 'description',
                value: experiment.description,
                rows: 3,
            }) }}

            {{ forms.textField({
                label: 'Traffic Allocation'|t('wink'),
                id: 'trafficPercent',
                name: 'trafficPercent',
                type: 'number',
                value: experiment.trafficPercent,
                min: 1,
                max: 100,
                size: 5,
                instructions: 'Percentage of visitors to include in this experiment.'|t('wink'),
                errors: experiment.getErrors('trafficPercent'),
            }) }}

            {% set winkDelivery = craft.app.plugins.getPlugin('wink').delivery %}
            {% set winkDefault = craft.app.plugins.getPlugin('wink').settings.deliveryMode %}
            {{ forms.selectField({
                label: 'Delivery'|t('wink'),
                id: 'deliveryMode',
                name: 'deliveryMode',
                value: experiment.deliveryMode ?? '',
                options: [
                    {label: 'Use the plugin setting ({mode})'|t('wink', {mode: (winkDefault == 'server' ? 'Server-side'|t('wink') : (winkDefault == 'cacheSafe' ? 'Cache-safe'|t('wink') : 'Automatic'|t('wink')))}), value: ''},
                    {label: 'Server-side'|t('wink'), value: 'server'},
                    {label: 'Cache-safe'|t('wink'), value: 'cacheSafe'},
                ],
                instructions: 'Cache-safe puts every variant in the page and chooses in the browser, so pages with this experiment can be cached by Blitz, a CDN or any full-page cache. Server-side chooses while the page renders, and is only right on pages that are never cached.'|t('wink'),
                warning: winkDelivery.getServerSideWarning(experiment),
                errors: experiment.getErrors('deliveryMode'),
            }) }}
        </div>

        {# Variants #}
        <hr>
        <h2>{{ 'Variants'|t('wink') }}</h2>
        <p class="light">{{ 'Define the content variants for this experiment. Weights must add up to 100.'|t('wink') }}</p>
        {{ forms.errorList(experiment.getErrors('variants')) }}

        <div id="wink-variants" data-wink-rows="variant" data-wink-min="2" data-wink-confirm-remove="{{ 'Removing a saved variant also deletes the impressions and conversions recorded for it. Remove it?'|t('wink') }}">
            {% for variant in experiment.getVariants() %}
                {{ _self.variantRow('v' ~ loop.index0, variant) }}
            {% endfor %}
        </div>
        <div class="flex">
            <button type="button" class="btn add icon dashed" data-wink-add="variant">{{ 'Add a variant'|t('wink') }}</button>
            <div class="light" data-wink-weight-total data-label="{{ 'Total weight: {total}'|t('wink') }}" aria-live="polite"></div>
        </div>
        <template id="wink-variant-template">
            {{ _self.variantRow('__ROW__', create({class: 'justinholtweb\\wink\\models\\Variant', weight: 0})) }}
        </template>

        {# Goals #}
        <hr>
        <h2>{{ 'Conversion Goals'|t('wink') }}</h2>
        <p class="light">{{ 'Define what counts as a conversion for this experiment.'|t('wink') }}</p>
        {{ forms.errorList(experiment.getErrors('goals')) }}

        {% set targetPlaceholders = {} %}
        {% for goalType in goalTypes %}
            {% set targetPlaceholders = targetPlaceholders|merge({(goalType.value): goalType.targetPlaceholder()}) %}
        {% endfor %}
        <div id="wink-goals" data-wink-rows="goal" data-wink-min="1" data-wink-placeholders="{{ targetPlaceholders|json_encode }}" data-wink-confirm-remove="{{ 'Removing a saved goal also detaches the conversions recorded for it. Remove it?'|t('wink') }}">
            {% for goal in experiment.getGoals() %}
                {{ _self.goalRow('g' ~ loop.index0, goal, goalTypes) }}
            {% endfor %}
        </div>
        <button type="button" class="btn add icon dashed" data-wink-add="goal">{{ 'Add a goal'|t('wink') }}</button>
        <template id="wink-goal-template">
            {{ _self.goalRow('__ROW__', create('justinholtweb\\wink\\models\\Goal'), goalTypes) }}
        </template>
    </div>
{% endblock %}

{% block details %}
    <div class="meta">
        {% if experiment.id %}
            <div class="data">
                <h5 class="heading">{{ 'Status'|t('wink') }}</h5>
                <div class="value">
                    <span class="status {{ experiment.experimentStatusEnum.color }}"></span>
                    {{ experiment.experimentStatusEnum.label }}
                </div>
            </div>

            {% set statusEnum = experiment.experimentStatusEnum %}

            {% if statusEnum.canTransitionTo(constant('justinholtweb\\wink\\enums\\ExperimentStatus::Running')) %}
                <div class="data">
                    <button type="button" class="btn submit small wink-status-btn" data-transition="start" data-confirm="{{ 'Are you sure you want to start this experiment?'|t('wink') }}">{{ 'Start'|t('wink') }}</button>
                </div>
            {% endif %}

            {% if statusEnum.canTransitionTo(constant('justinholtweb\\wink\\enums\\ExperimentStatus::Paused')) %}
                <div class="data">
                    <button type="button" class="btn small wink-status-btn" data-transition="pause" data-confirm="{{ 'Are you sure you want to pause this experiment?'|t('wink') }}">{{ 'Pause'|t('wink') }}</button>
                </div>
            {% endif %}

            {% if statusEnum.canTransitionTo(constant('justinholtweb\\wink\\enums\\ExperimentStatus::Completed')) %}
                <div class="data">
                    <button type="button" class="btn small wink-status-btn" data-transition="complete" data-confirm="{{ 'Are you sure you want to complete this experiment?'|t('wink') }}">{{ 'Complete'|t('wink') }}</button>
                </div>
            {% endif %}

            {% if statusEnum.canTransitionTo(constant('justinholtweb\\wink\\enums\\ExperimentStatus::Archived')) %}
                <div class="data">
                    <button type="button" class="btn small wink-status-btn" data-transition="archive" data-confirm="{{ 'Are you sure you want to archive this experiment?'|t('wink') }}">{{ 'Archive'|t('wink') }}</button>
                </div>
            {% endif %}

            <div class="data">
                <h5 class="heading">{{ 'Variants'|t('wink') }}</h5>
                <div class="value">{{ experiment.variantCount }}</div>
            </div>

            {% if experiment.startDate %}
                <div class="data">
                    <h5 class="heading">{{ 'Started'|t('wink') }}</h5>
                    <div class="value">{{ experiment.startDate|date }}</div>
                </div>
            {% endif %}

            {% if experiment.endDate %}
                <div class="data">
                    <h5 class="heading">{{ 'Ended'|t('wink') }}</h5>
                    <div class="value">{{ experiment.endDate|date }}</div>
                </div>
            {% endif %}

            <hr>

            <div class="data">
                <a href="{{ cpUrl('wink/reports/' ~ experiment.id) }}" class="btn">{{ 'View Report'|t('wink') }}</a>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% do view.registerAssetBundle('justinholtweb\\wink\\web\\assets\\cp\\CpAsset') %}
{% js %}
document.querySelectorAll('.wink-status-btn').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
        e.preventDefault();
        if (confirm(this.dataset.confirm)) {
            // `transition`, not `action`: sendActionRequest() strips `action` from the data.
            Craft.sendActionRequest('POST', 'wink/experiments/update-status', {
                data: {
                    id: {{ experiment.id ?? 'null' }},
                    transition: this.dataset.transition,
                }
            }).then(function() {
                location.reload();
            }).catch(function(error) {
                Craft.cp.displayError(error?.response?.data?.message || {{ 'Could not update experiment status.'|t('wink')|json_encode|raw }});
            });
        }
    });
});
{% endjs %}

{% macro variantRow(key, variant) %}
    {% import '_includes/forms.twig' as forms %}
    {% set prefix = 'variants[' ~ key ~ ']' %}
    <div class="wink-variant-row" data-wink-row data-saved="{{ variant.id ? 1 : 0 }}">
        {{ hiddenInput(prefix ~ '[id]', variant.id ?? '') }}

        <div class="flex">
            <div class="flex-grow">
                {{ forms.textField({
                    label: 'Title'|t('app'),
                    id: 'wink-variant-' ~ key ~ '-title',
                    name: prefix ~ '[title]',
                    value: variant.title,
                    required: true,
                    size: 30,
                    errors: variant.getErrors('title'),
                }) }}
            </div>
            <div>
                {{ forms.textField({
                    label: 'Handle'|t('wink'),
                    id: 'wink-variant-' ~ key ~ '-handle',
                    name: prefix ~ '[handle]',
                    value: variant.handle,
                    required: true,
                    size: 20,
                    errors: variant.getErrors('handle'),
                }) }}
            </div>
            <div>
                {{ forms.textField({
                    label: 'Weight'|t('wink'),
                    id: 'wink-variant-' ~ key ~ '-weight',
                    name: prefix ~ '[weight]',
                    value: variant.weight,
                    type: 'number',
                    min: 0,
                    max: 100,
                    size: 5,
                    errors: variant.getErrors('weight'),
                }) }}
            </div>
            <div class="wink-row-choice">
                {{ forms.radio({
                    id: 'wink-variant-' ~ key ~ '-control',
                    name: 'controlVariant',
                    value: key,
                    checked: variant.isControl,
                    label: 'Control'|t('wink'),
                }) }}
            </div>
            <div>
                <button type="button" class="btn small" data-wink-remove>{{ 'Remove'|t('app') }}</button>
            </div>
        </div>

        {{ forms.textareaField({
            label: 'Content'|t('wink'),
            id: 'wink-variant-' ~ key ~ '-content',
            name: prefix ~ '[content]',
            value: variant.content,
            rows: 4,
            instructions: 'HTML or text content for this variant.'|t('wink'),
        }) }}
    </div>
{% endmacro %}

{% macro goalRow(key, goal, goalTypes) %}
    {% import '_includes/forms.twig' as forms %}
    {% set prefix = 'goals[' ~ key ~ ']' %}
    <div class="wink-goal-row" data-wink-row data-saved="{{ goal.id ? 1 : 0 }}">
        {{ hiddenInput(prefix ~ '[id]', goal.id ?? '') }}

        <div class="flex">
            <div class="flex-grow">
                {{ forms.textField({
                    label: 'Name'|t('app'),
                    id: 'wink-goal-' ~ key ~ '-name',
                    name: prefix ~ '[name]',
                    value: goal.name,
                    required: true,
                    errors: goal.getErrors('name'),
                }) }}
            </div>
            <div>
                {{ forms.textField({
                    label: 'Handle'|t('wink'),
                    id: 'wink-goal-' ~ key ~ '-handle',
                    name: prefix ~ '[handle]',
                    value: goal.handle,
                    required: true,
                    errors: goal.getErrors('handle'),
                }) }}
            </div>
            <div class="wink-row-choice">
                {{ forms.radio({
                    id: 'wink-goal-' ~ key ~ '-primary',
                    name: 'primaryGoal',
                    value: key,
                    checked: goal.isPrimary,
                    label: 'Primary'|t('wink'),
                }) }}
            </div>
            <div>
                <button type="button" class="btn small" data-wink-remove>{{ 'Remove'|t('app') }}</button>
            </div>
        </div>

        <div class="flex">
            <div>
                {{ forms.selectField({
                    label: 'Goal Type'|t('wink'),
                    id: 'wink-goal-' ~ key ~ '-type',
                    name: prefix ~ '[goalType]',
                    value: goal.goalType.value,
                    options: goalTypes|map(g => {label: g.label()|t('wink'), value: g.value}),
                }) }}
            </div>
            <div class="flex-grow">
                {{ forms.textField({
                    label: 'Target'|t('wink'),
                    id: 'wink-goal-' ~ key ~ '-target',
                    name: prefix ~ '[goalTarget]',
                    value: goal.goalTarget,
                    placeholder: goal.goalType.targetPlaceholder(),
                    instructions: 'Page View: a URL path, where `*` matches anything (`/thank-you*`). Click and Form Submit: a CSS selector. Custom Event: none needed; send the conversion from your own script with `Wink.convert(\'handle\')`.'|t('wink'),
                    errors: goal.getErrors('goalTarget'),
                }) }}
            </div>
        </div>
    </div>
{% endmacro %}
